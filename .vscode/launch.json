{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "All Python services (start_all.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/start_all.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Gateway :8000",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "gateway_app.main:app",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/gateway"
    },
    {
      "name": "Auth :8001",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "auth_app.main:app",
        "--port",
        "8001",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/auth_service"
    },
    {
      "name": "Operation :8002",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "ops_app.main:app",
        "--port",
        "8002",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/ops_service"
    },
    {
      "name": "Report :8003",
