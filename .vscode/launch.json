      ],
      "cwd": "${workspaceFolder}/media_service"
    },
    {
      "name": "Chat :8005",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "chat_app.main:app",
        "--port",
        "8005",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/chat_service"
    },
    {
      "name": "Notify :8006",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "notify_app.main:app",
        "--port",
